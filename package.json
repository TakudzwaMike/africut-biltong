{
	"name": "vision-ai.tech",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit generate && drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --loader ts-node/esm src/lib/server/db/seed.js",
		"user:set-password": "node scripts/update-password.js"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@faker-js/faker": "^10.2.0",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/adapter-vercel": "^5.8.2",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.30.2",
		"eslint": "^9.18.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^4.0.17"
	},
	"dependencies": {
		"@iconify/svelte": "^5.0.1",
		"@lucia-auth/adapter-drizzle": "^1.0.7",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@paralleldrive/cuid2": "^3.0.4",
		"@tiptap/core": "^3.10.5",
		"@tiptap/extension-bubble-menu": "^3.10.5",
		"@tiptap/extension-link": "^3.10.5",
		"@tiptap/starter-kit": "^3.10.5",
		"@vercel/blob": "^0.23.4",
		"canvas-confetti": "^1.9.4",
		"drizzle-orm": "^0.40.0",
		"editorjs-html": "^4.0.5",
		"lucia": "^3.2.0",
		"oslo": "^1.2.1",
		"postgres": "^3.4.7",
		"qrcode": "^1.5.4",
		"resend": "^6.0.2",
		"sharp": "^0.34.3",
		"zod": "^4.1.13"
	}
}
